class Solver:
    def __init__(self) -> None: ...
    def set_problem(self, problem: Problem, options: SolverOptions) -> None: ...
    def solve(self) -> SolveResult: ...
    def convergence(self) -> bool: ...
    def get_problem(self) -> Problem: ...
    def get_workspace(self) -> Workspace: ...
    def get_filter(self) -> Filter: ...
    def get_kkt_system(self) -> KKTSystem: ...
    def get_relaxation_map(self) -> RelaxationMap: ...
    def update_relaxed_slack_values(self) -> None: ...
    def update_primal_residuals(self) -> None: ...
    def apply_newton_step(self, step_size: float) -> None: ...
    def filter_linesearch(self) -> bool: ...
    def entry_from_solution(self) -> tuple[float, float]: ...
    def get_options(self) -> SolverOptions: ...

    @property
    def n_primals(self) -> int: ...
    @property
