    def solve(self, rhs: numpy.ndarray) -> numpy.ndarray: ...
    def problem_to_internal(self, x_problem: numpy.ndarray) -> numpy.ndarray: ...
    def internal_to_problem(self, x_internal: numpy.ndarray) -> numpy.ndarray: ...

    @property
    def built(self) -> bool: ...
    @property
    def matrix(self) -> tuple[int, int, numpy.ndarray, numpy.ndarray, numpy.ndarray]: ...
    @property
